# ===== Supabase =====
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Twilio =====
# From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# ===== Resend (email) =====
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender address in Resend
EMAIL_FROM="HVAC Revenue Recovery <reports@yourdomain.com>"

# ===== App =====
# Public base URL of the deployed app (used to build Twilio webhook URLs and dashboard links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to authorize the weekly-report cron endpoint (generate: openssl rand -hex 32)
CRON_SECRET=change-me

# Secret used to authorize demo-mode endpoints from the dashboard (generate: openssl rand -hex 32)
DEMO_SECRET=change-me

# Set to "true" to skip real Twilio/Resend sends globally (messages are logged to the DB only).
# Demo companies never send real SMS regardless of this flag.
DRY_RUN=false

# Set to "true" to skip Twilio webhook signature validation (local dev ONLY)
SKIP_TWILIO_SIGNATURE_VALIDATION=false
